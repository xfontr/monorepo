{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(pnpm exec nx show project:*)",
            "Bash(pnpm exec nx graph:*)",
            "Bash(pnpm exec nx affected:*)",
            "Bash(pnpm exec nx run-many:*)",
            "Bash(pnpm exec eslint:*)",
            "Bash(pnpm install)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git ls-files:*)",
            "Bash(git grep:*)",
            "Bash(git rev-list:*)",
            "Bash(gh issue list:*)",
            "Bash(pnpm check:*)",
            "Bash(pnpm issue:brief:*)",
            "Bash(pnpm ci:failures:*)",
            "Bash(.claude/skills/repo-review/collect-facts.sh:*)"
        ],
        "deny": [
            "Edit(**/CHANGELOG.md)",
            "Write(**/CHANGELOG.md)",
            "Edit(docs/FEATURES.md)",
            "Write(docs/FEATURES.md)",
            "Bash(pnpm exec nx release:*)",
            "Bash(nx release:*)",
            "Bash(pnpm release:*)",
            "Read(.env)",
            "Read(**/.env)",
            "Read(**/.env.local)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-live.sh",
                        "timeout": 5,
                        "statusMessage": "Guarding live systems"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-fix.sh",
                        "timeout": 60,
                        "statusMessage": "eslint --fix"
                    },
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-invariants.sh",
                        "timeout": 15,
                        "statusMessage": "Checking repo invariants"
                    }
                ]
            }
        ]
    }
}
