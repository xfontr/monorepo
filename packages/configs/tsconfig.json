{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],

        "module": "ESNext",
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,

        "rootDir": ".",
        "noEmit": true,

        "strict": true,
        "skipLibCheck": true,

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "forceConsistentCasingInFileNames": true,

        "verbatimModuleSyntax": true
    },
    "include": ["src", "eslint.config.ts"]
}
