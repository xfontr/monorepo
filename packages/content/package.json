{
  "name": "@monorepo/content",
  "version": "0.0.11",
  "description": "Content ports",
  "author": "Xifré Font",
  "license": "ISC",
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*.ts",
    "#nuxt/*": "./src/nuxt/*.ts"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts"
    },
    "./nuxt": {
      "import": "./src/nuxt/module.ts"
    },
    "./testing": {
      "import": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "lint": "nx eslint:lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest . --watch=false",
    "test:dev": "vitest .",
    "test:coverage": "vitest . --watch=false --coverage"
  },
  "nx": {
    "tags": [
      "type:content",
      "scope:shared"
    ]
  },
  "dependencies": {
    "ofetch": "^1.5.1",
    "ohash": "^2.0.11"
  },
  "peerDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nuxt/kit": "^4.5.0",
    "h3": "^1.15.11",
    "msw": "^3.0.1",
    "nitropack": "^2.13.4"
  },
  "peerDependenciesMeta": {
    "@faker-js/faker": {
      "optional": true
    },
    "@nuxt/kit": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "nitropack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@monorepo/configs": "workspace:*",
    "@nuxt/kit": "^4.5.0",
    "@nuxt/schema": "^4.5.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "h3": "^1.15.11",
    "msw": "^3.0.1",
    "nitropack": "^2.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
