#!/bin/sh

# =========================
# Colors
# =========================
RED="\033[0;31m"
GREEN="\033[0;32m"
YELLOW="\033[1;33m"
BLUE="\033[0;34m"
BOLD="\033[1m"
NC="\033[0m" # no color

info() {
  printf "${BLUE}➜ ${NC}%s\n" "$1"
}

success() {
  printf "${GREEN}✔ ${NC}%s\n" "$1"
}

warn() {
  printf "${YELLOW}⚠ ${NC}%s\n" "$1"
}

error() {
  printf "${RED}✖ ${NC}%s\n" "$1"
}

# =========================
# Get current branch
# =========================
BRANCH=$(git rev-parse --abbrev-ref HEAD)

echo ""
info "Current branch: $BRANCH"

# =========================
# Branch validation
# =========================
VALID_REGEX="^(hotfix|fix|feature|release)/.+"

if ! echo "$BRANCH" | grep -Eq "$VALID_REGEX"; then
  echo ""
  error "Invalid branch name: $BRANCH"
  echo "Allowed formats:"
  echo "  hotfix/*"
  echo "  fix/*"
  echo "  feature/*"
  echo "  release/*"
  echo ""
  exit 1
fi

success "Branch name is valid"

# =========================
# Flagged comments (TODO/FIXME)
# =========================
# Diffs only the commits being pushed, never the working tree: grepping the tree would fail
# every push forever the moment one TODO exists anywhere. git hands this hook one
# "local_ref local_sha remote_ref remote_sha" line per ref on stdin —
# see https://git-scm.com/docs/githooks#_pre_push.

echo ""
info "Scanning pushed commits for TODO/FIXME..."

ZERO_SHA="0000000000000000000000000000000000000000"
EMPTY_TREE_SHA="4b825dc642cb6eb9a060e54bf8d69288fbee4904" # every repo has it; the base for a branch's first push
FLAGGED=""

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  if [ "$LOCAL_SHA" = "$ZERO_SHA" ]; then
    continue # deleting a branch pushes nothing to scan
  fi

  BASE="$REMOTE_SHA"
  if [ "$REMOTE_SHA" = "$ZERO_SHA" ]; then
    BASE="$EMPTY_TREE_SHA"
  fi

  HITS=$(git diff "$BASE".."$LOCAL_SHA" | awk '
    /^\+\+\+ b\// { file = substr($0, 7); next }
    /^\+/ && /\/\/[ ]{1,2}(TODO|FIXME)/ { print "  " file ":  " substr($0, 2) }
  ')

  FLAGGED="$FLAGGED$HITS"
done

if [ -n "$FLAGGED" ]; then
  echo ""
  error "Push blocked: TODO/FIXME comments aren't allowed in pushed code"
  echo "$FLAGGED"
  echo ""
  echo "File each one as an issue, then remove the comment:"
  echo ""
  echo "  pnpm issue:add"
  echo ""
  exit 1
fi

success "No flagged comments found"

# =========================
# Docs drift heuristic
# =========================
# A nudge, not a gate — never fails the push. $BASE/$LOCAL_SHA are whatever the loop above last
# set, so this reuses the exact range being pushed instead of recomputing a merge-base. Skipped on
# a branch deletion (no LOCAL_SHA) and left to print-and-return on a non-interactive push, inside
# the script itself, since there's nobody here to answer its prompt.

if [ -n "$LOCAL_SHA" ] && [ "$LOCAL_SHA" != "$ZERO_SHA" ]; then
  echo ""
  info "Checking for possible docs drift..."
  DOCS_DRIFT_BASE="$BASE" DOCS_DRIFT_HEAD="$LOCAL_SHA" pnpm docs:drift || true
fi

# =========================
# Run checks
# =========================

echo ""
info "Running lint..."
pnpm lint

if [ $? -ne 0 ]; then
  error "Lint failed"
  exit 1
fi

echo ""
success "Lint passed"

echo ""
info "Running tests..."
pnpm test

if [ $? -ne 0 ]; then
  error "Tests failed"
  exit 1
fi

echo ""
success "Tests passed"

echo ""
info "Running typecheck..."
pnpm typecheck

if [ $? -ne 0 ]; then
  error "Typecheck failed"
  exit 1
fi

echo ""
success "Typecheck passed"

echo ""
success "All checks passed. Pushing allowed 🚀"
echo ""
echo ""

exit 0