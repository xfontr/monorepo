#!/bin/sh

if [ -t 1 ]; then
  BLUE="\033[0;34m"
  GREEN="\033[0;32m"
  YELLOW="\033[1;33m"
  DIM="\033[2m"
  NC="\033[0m"
else
  BLUE=""
  GREEN=""
  YELLOW=""
  DIM=""
  NC=""
fi

git diff-tree --no-commit-id --name-status -r HEAD | sed 's/^/  /'
printf "\n${GREEN}✔${NC} ${DIM}%s · %s · %s${NC}\n" "$(git show -s --format=%an HEAD)" "$(git show -s --format=%ar HEAD)" "$(git branch --show-current)"

pnpm docs:drift || true
