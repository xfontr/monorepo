#!/bin/sh

# Scripts record a usage row unless this is set; a hook running them is not anyone choosing to.
export MONOREPO_GIT_HOOK=1

YELLOW="\033[1;33m"
NC="\033[0m"

if ! git rev-parse --verify 'ORIG_HEAD^{commit}' >/dev/null 2>&1 || \
    ! git rev-parse --verify 'HEAD^{commit}' >/dev/null 2>&1; then
    exit 0
fi

STATUS=0
git diff --quiet ORIG_HEAD HEAD -- pnpm-lock.yaml >/dev/null 2>&1 || STATUS=$?

# pnpm keeps the lockfile it last installed here, minus the leading packageManager document.
INSTALLED=node_modules/.pnpm/lock.yaml

if [ "$STATUS" -eq 1 ] && ! awk 'NR == 1 && $0 == "---" { skip = 1; next }
    skip && $0 == "---" { skip = 0; next }
    !skip' pnpm-lock.yaml | cmp -s - "$INSTALLED"; then
    printf "\n${YELLOW}📦 ${NC}pnpm-lock.yaml changed — run pnpm install.\n"
fi

if ! git diff --quiet ORIG_HEAD HEAD -- ':(glob)**/.env.example' >/dev/null 2>&1; then
    printf "\n${YELLOW}🔑 ${NC}A .env.example changed — syncing .env files.\n"
    pnpm env:sync || true
fi

exit 0
