    "license": "ISC",
    "packageManager": "pnpm@10.7.1",
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    },
    "scripts": {
        "lint": "nx affected -t lint",
        "typecheck": "nx affected -t typecheck",
        "build": "nx affected -t build",
        "test": "nx affected -t test",
        "test:coverage": "nx affected -t test:coverage",
        "graph": "nx graph",
        "issue:add": "pnpm --filter @monorepo/scripts run issue:add",
        "issue:pick": "pnpm --filter @monorepo/scripts run issue:pick",
        "docs:drift": "pnpm --filter @monorepo/scripts run docs:drift",
        "docs:map": "pnpm --filter @monorepo/scripts run docs:map",
        "release": "nx release --skip-publish",
        "release:dry": "nx release --skip-publish --dry-run"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.1.0",
        "@commitlint/config-conventional": "^21.1.0",
        "@nx/eslint": "23.0.1",
        "@nx/js": "23.0.1",
        "@nx/nuxt": "23.0.1",
        "@nx/vite": "23.0.1",
        "@nx/vitest": "23.0.1",
        "husky": "^9.1.7",
        "nx": "23.0.1"
    }
}
