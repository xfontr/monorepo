{
    "name": "monorepo",
    "version": "0.0.1",
    "description": "",
    "author": "Xifré Font",
    "license": "ISC",
    "packageManager": "pnpm@12.4.2",
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    },
    "scripts": {
        "quick-start": "husky && pnpm env:sync && pnpm test:coverage && pnpm exec nx collect @monorepo/developer-portal",
        "dev": "pnpm --silent --dir infrastructure/scripts cli src/dev/index.ts",
        "lint": "nx affected --base=master -t lint",
        "typecheck": "nx affected --base=master -t typecheck",
        "build": "nx affected --base=master -t build",
        "test": "nx affected --base=master -t test",
        "test:coverage": "nx run-many -t test:coverage && pnpm --silent --dir infrastructure/scripts cli src/coverage-report/index.ts",
        "graph": "nx graph",
        "issue:add": "pnpm --silent --dir infrastructure/scripts cli src/issue/index.ts add",
        "issue:pick": "pnpm --silent --dir infrastructure/scripts cli src/issue/index.ts pick",
        "issue:brief": "pnpm --silent --dir infrastructure/scripts cli src/issue/index.ts brief",
        "issue:ship": "pnpm --silent --dir infrastructure/scripts cli src/ship/index.ts",
        "check": "nx affected --base=master -t nuxt-prepare --outputStyle=static-failures-only && nx affected --base=master -t eslint:lint typecheck test --outputStyle=static-failures-only; s=$?; pnpm docs:map --check || s=1; exit $s",
        "ci:failures": "pnpm --silent --dir infrastructure/scripts cli src/ci-failures/index.ts",
        "worktree:prepare": "pnpm --silent --dir infrastructure/scripts cli src/worktree/index.ts",
        "docs:drift": "pnpm --silent --dir infrastructure/scripts cli src/drift/index.ts",
        "docs:map": "pnpm --silent --dir infrastructure/scripts cli src/map/index.ts",
        "invariants:check": "pnpm --silent --dir infrastructure/scripts cli src/invariants/index.ts",
        "usage:flush": "pnpm --silent --dir infrastructure/scripts cli src/usage/index.ts",
        "env:sync": "pnpm --silent --dir infrastructure/scripts cli src/env-sync/index.ts",
        "workflow:setup": "pnpm --silent --dir infrastructure/scripts cli src/workflow/index.ts setup",
        "workflow:sync": "pnpm --silent --dir infrastructure/scripts cli src/workflow/index.ts sync",
        "workflow:next": "pnpm --silent --dir infrastructure/scripts cli src/workflow/index.ts next",
        "workflow:file": "pnpm --silent --dir infrastructure/scripts cli src/workflow/index.ts file",
        "workflow:drop": "pnpm --silent --dir infrastructure/scripts cli src/workflow/index.ts drop",
        "brand:extract": "pnpm --silent --dir infrastructure/scripts cli src/brand/index.ts extract",
        "brand:contrast": "pnpm --silent --dir infrastructure/scripts cli src/brand/index.ts contrast",
        "release": "nx release --skip-publish",
        "release:dry": "nx release --skip-publish --dry-run"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@nx/eslint": "24.0.6",
        "@nx/js": "24.0.6",
        "@nx/nuxt": "24.0.6",
        "@nx/vite": "24.0.6",
        "@nx/vitest": "24.0.6",
        "husky": "^9.1.7",
        "nx": "24.0.6"
    }
}
