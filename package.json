{
    "name": "monorepo",
    "version": "0.0.1",
    "description": "",
    "author": "Xifré Font",
    "license": "ISC",
    "packageManager": "pnpm@12.4.2",
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    },
    "scripts": {
        "quick-start": "husky && pnpm test:coverage && pnpm exec nx collect @monorepo/developer-portal",
        "dev": "pnpm --dir infrastructure/scripts exec node --disable-warning=ExperimentalWarning src/dev/index.ts",
        "lint": "nx affected --base=master -t lint",
        "typecheck": "nx affected --base=master -t typecheck",
        "build": "nx affected --base=master -t build",
        "test": "nx affected --base=master -t test",
        "test:coverage": "nx run-many -t test:coverage && pnpm --dir infrastructure/scripts exec node --disable-warning=ExperimentalWarning src/coverage-report/index.ts",
        "graph": "nx graph",
        "issue:add": "pnpm --dir infrastructure/scripts exec node --disable-warning=ExperimentalWarning src/issue/index.ts add",
        "issue:pick": "pnpm --dir infrastructure/scripts exec node --disable-warning=ExperimentalWarning src/issue/index.ts pick",
        "issue:ship": "pnpm --dir infrastructure/scripts exec node --disable-warning=ExperimentalWarning src/ship/index.ts",
        "agents:sync": "pnpm --dir infrastructure/scripts exec node --disable-warning=ExperimentalWarning src/agents-sync/index.ts",
        "docs:drift": "pnpm --dir infrastructure/scripts exec node --disable-warning=ExperimentalWarning src/drift/index.ts",
        "docs:map": "pnpm --dir infrastructure/scripts exec node --disable-warning=ExperimentalWarning src/map/index.ts",
        "package:check": "pnpm --dir infrastructure/scripts exec node --disable-warning=ExperimentalWarning src/package-contracts/index.ts",
        "review:version": "pnpm --dir infrastructure/scripts exec node --disable-warning=ExperimentalWarning src/review-version/index.ts",
        "release": "nx release --skip-publish",
        "release:dry": "nx release --skip-publish --dry-run"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.1.0",
        "@commitlint/config-conventional": "^21.1.0",
        "@nx/eslint": "23.2.1",
        "@nx/js": "23.2.1",
        "@nx/nuxt": "23.2.1",
        "@nx/vite": "23.2.1",
        "@nx/vitest": "23.2.1",
        "husky": "^9.1.7",
        "nx": "23.2.1"
    }
}
