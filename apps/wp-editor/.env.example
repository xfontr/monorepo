# WORDPRESS — a dedicated Application Password on an Editor or Admin account
NUXT_WORDPRESS_USERNAME=
NUXT_WORDPRESS_APPLICATION_PASSWORD=

# STORE — absolute path to the changeset store, outside the repo
NUXT_EDITOR_STORE=

# OVERRIDES — shared/site.ts has the value; uncomment only to replace it, never to leave it empty
# NUXT_WORDPRESS_BASE_URL=
