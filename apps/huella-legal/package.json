{
    "name": "@monorepo/huella-legal",
    "description": "Huella Legal — a WIP redesign of a law blog",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nx nuxt:build",
        "build:storybook": "nuxi prepare && storybook build",
        "storybook": "nuxi prepare && storybook dev -p 6007",
        "dev": "nx serve",
        "preview": "nuxt preview",
        "lint": "nx eslint:lint",
        "nuxt-prepare": "nuxi prepare",
        "typecheck": "nuxt typecheck",
        "test": "vitest . --watch=false",
        "test:dev": "vitest .",
        "test:coverage": "vitest . --watch=false --coverage",
        "test:e2e": "playwright test"
    },
    "nx": {
        "tags": [
            "type:app",
            "scope:huella-legal"
        ],
        "targets": {
            "test:e2e": {
                "inputs": [
                    "default",
                    "^production",
                    "{workspaceRoot}/infrastructure/translations/projects/huella-legal/*.json",
                    {
                        "env": "CI"
                    }
                ]
            }
        }
    },
    "dependencies": {
        "@monorepo/content": "workspace:*",
        "@monorepo/i18n": "workspace:*",
        "@monorepo/observability": "workspace:*",
        "@monorepo/ui": "workspace:*",
        "@nuxt/fonts": "catalog:",
        "@nuxt/ui": "^4.11.0",
        "@nuxtjs/i18n": "catalog:",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@pinia/nuxt": "^1.0.2",
        "entities": "^8.1.0",
        "idb": "^8.0.3",
        "nuxt": "catalog:",
        "pinia": "^4.0.3",
        "reading-time": "^1.5.0",
        "rehype-parse": "^9.0.1",
        "rehype-sanitize": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "striptags": "^3.2.0",
        "tailwindcss": "^4.3.3",
        "unified": "^11.0.5"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@faker-js/faker": "^10.6.0",
        "@monorepo/configs": "workspace:*",
        "@nuxt/test-utils": "^4.3.2",
        "@playwright/test": "1.63.0",
        "@storybook/vue3-vite": "^10.6.0",
        "@types/hast": "^3.0.5",
        "@types/node": "catalog:",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "catalog:",
        "@vue/test-utils": "^2.4.11",
        "eslint": "catalog:",
        "fontless": "^1.2.1",
        "happy-dom": "^20.10.6",
        "msw": "^3.0.1",
        "storybook": "^10.6.0",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vue": "catalog:",
        "vue-i18n": "^11.4.12",
        "vue-tsc": "catalog:"
    }
}
