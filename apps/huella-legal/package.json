{
    "name": "@monorepo/huella-legal",
    "description": "Huella Legal — a WIP redesign of a law blog",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "nuxi prepare && nx nuxt:build",
        "build:storybook": "nuxi prepare && storybook build",
        "storybook": "nuxi prepare && storybook dev -p 6007",
        "dev": "pnpm cache:clear && nx serve",
        "dev:api": "pnpm cache:clear && nuxt dev",
        "cache:clear": "node -e \"for (const group of ['articles', 'content']) require('node:fs').rmSync('.nuxt/cache/' + group, { recursive: true, force: true })\"",
        "preview": "nuxt preview",
        "lint": "nx eslint:lint",
        "nuxt-prepare": "nuxi prepare",
        "typecheck": "nuxt typecheck",
        "test": "vitest . --watch=false",
        "test:dev": "vitest .",
        "test:coverage": "vitest . --watch=false --coverage",
        "test:e2e": "playwright test"
    },
    "nx": {
        "tags": [
            "type:app",
            "scope:huella-legal"
        ],
        "targets": {
            "build": {
                "inputs": [
                    "production",
                    "^production",
                    {
                        "env": "CONTEXT"
                    }
                ]
            },
            "nuxt:build": {
                "inputs": [
                    "production",
                    "^production",
                    {
                        "externalDependencies": [
                            "nuxt"
                        ]
                    },
                    {
                        "env": "CONTEXT"
                    }
                ]
            },
            "serve": {
                "options": {
                    "env": {
                        "NODE_OPTIONS": "--import ./mocks/server.ts",
                        "NUXT_CONTENT_VENDOR_BASE_URL": "http://localhost/wordpress"
                    }
                }
            },
            "test:e2e": {
                "inputs": [
                    "default",
                    "^production",
                    "{workspaceRoot}/infrastructure/translations/projects/huella-legal/*.json",
                    {
                        "env": "CI"
                    }
                ]
            }
        }
    },
    "dependencies": {
        "@monorepo/content": "workspace:*",
        "@monorepo/i18n": "workspace:*",
        "@monorepo/observability": "workspace:*",
        "@monorepo/ui": "workspace:*",
        "@nuxt/fonts": "catalog:",
        "@nuxt/image": "~2.2.0",
        "@nuxt/scripts": "^1.3.12",
        "@nuxt/ui": "^4.11.0",
        "@nuxtjs/i18n": "catalog:",
        "@nuxtjs/robots": "^7.0.2",
        "@nuxtjs/sitemap": "^9.1.0",
        "@nuxtjs/turnstile": "^1.1.3",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/semantic-conventions": "^1.43.0",
        "@vueuse/core": "^15.0.0",
        "feed": "^6.0.0",
        "hast-util-to-text": "^4.0.2",
        "idb": "^8.0.3",
        "nuxt": "catalog:",
        "nuxt-schema-org": "^7.0.1",
        "nuxt-seo-utils": "^9.0.1",
        "ofetch": "^1.5.1",
        "rehype-parse": "^9.0.1",
        "rehype-sanitize": "^6.0.0",
        "rehype-stringify": "^10.0.1",
        "tailwindcss": "^4.3.3",
        "unified": "^11.0.5",
        "valibot": "^1.5.0",
        "vanilla-cookieconsent": "^3.2.1"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@faker-js/faker": "^10.6.0",
        "@monorepo/configs": "workspace:*",
        "@nuxt/test-utils": "^4.3.2",
        "@playwright/test": "catalog:",
        "@storybook/vue3-vite": "^10.6.0",
        "@types/hast": "^3.0.5",
        "@types/node": "catalog:",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/coverage-v8": "catalog:",
        "@vue/test-utils": "^2.4.11",
        "eslint": "catalog:",
        "fontless": "^1.3.2",
        "happy-dom": "^21.0.1",
        "msw": "^3.0.1",
        "storybook": "^10.6.0",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vue": "catalog:",
        "vue-i18n": "^11.4.12",
        "vue-router": "^5.3.1",
        "vue-tsc": "catalog:"
    }
}
