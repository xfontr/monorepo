# CONTENT — the WordPress site root, without /wp-json
NUXT_CONTENT_VENDOR_BASE_URL=

# NEWSLETTER
NUXT_NEWSLETTER_API_KEY=
NUXT_NEWSLETTER_FORM_ID=

# MAIL — Contacto and Publicar
NUXT_MAIL_API_KEY=

# A YYYY-MM-DD date
NUXT_FORMS_SLOW_REPLIES_UNTIL=

# COMMENTS
NUXT_COMMENTS_USERNAME=
NUXT_COMMENTS_APPLICATION_PASSWORD=

# TURNSTILE
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# OBSERVABILITY — unset means no telemetry
NUXT_PUBLIC_OBSERVABILITY_URL=
NUXT_PUBLIC_OBSERVABILITY_APP_ENVIRONMENT=
NUXT_OBSERVABILITY_URL=
NUXT_OBSERVABILITY_INSTANCE_ID=
NUXT_OBSERVABILITY_TOKEN=

# TRACKERS
NUXT_PUBLIC_TRACKERS_GOOGLE_ANALYTICS_ID=

# DEPLOY — `production` on the production deploy, `preview` on every other deploy, unset elsewhere
NUXT_SITE_ENV=

# STAGING GATE — the login staging and *.netlify.app ask for; read by the edge function, not Nuxt
STAGING_USERNAME=
STAGING_PASSWORD=

# SOCIAL
NUXT_PUBLIC_SOCIAL_INSTAGRAM=
NUXT_PUBLIC_SOCIAL_LINKEDIN=
NUXT_PUBLIC_SOCIAL_X=

# OVERRIDES — nuxt.config.ts has the value; uncomment only to replace it, never to leave it empty
# NUXT_PUBLIC_SITE_URL=
# NUXT_NEWSLETTER_BASE_URL=
# NUXT_PUBLIC_SUBMISSION_EMAIL=
# NUXT_MAIL_BASE_URL=
# NUXT_MAIL_FROM=
# NUXT_MAIL_TO=
# NUXT_PUBLIC_PAGE_SLUGS=
# NUXT_ARTICLES_HIDDEN_TERMS=
