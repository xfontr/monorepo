# TRANSLATIONS
# The TMS API root, with scheme. `nuxt dev` uses the `internal` vendor, so locally this is the
# translations server and the project and token stay unset; a build uses Tolgee and needs all three.
NUXT_TRANSLATIONS_VENDOR_BASE_URL=
NUXT_TRANSLATIONS_VENDOR_PROJECT=
NUXT_TRANSLATIONS_VENDOR_OPTIONS_TOKEN=

# CONTENT
# The WordPress site root, without /wp-json — the provider owns that path
NUXT_CONTENT_VENDOR_BASE_URL=

# OBSERVABILITY (browser)
# The Faro collector URL; unset keeps browser telemetry off
NUXT_PUBLIC_OBSERVABILITY_URL=
NUXT_PUBLIC_OBSERVABILITY_APP_VERSION=
NUXT_PUBLIC_OBSERVABILITY_APP_ENVIRONMENT=

# OBSERVABILITY (server)
# The OTLP gateway URL; unset keeps server telemetry off
NUXT_OBSERVABILITY_URL=
NUXT_OBSERVABILITY_INSTANCE_ID=
NUXT_OBSERVABILITY_TOKEN=
